<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_notification"
            android:tint="#3B82F6" />

        <TextView
            android:id="@+id/notif_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="CLASS IN SESSION"
            android:textColor="#D4D4D4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/notif_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notification_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subject Title -->
    <TextView
        android:id="@+id/notif_subject_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Data Structures and Algorithms"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Subtitle (Room & Faculty) -->
    <TextView
        android:id="@+id/notif_subject_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="CS102 • Room Lab 3 • Dr. Alan Turing"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/notif_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="45"
        android:progressDrawable="@drawable/progress_bar_custom" />
</LinearLayout>
